#!/bin/sh
set -eu

appdir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
case ${1-} in
    --help|-h|--version) exec "$appdir/everybodys-golf" "$@" ;;
    ''|--*)
        printf '%s\n' 'Usage: EverybodyGolf.AppImage DATA-DIRECTORY [OPTIONS]' >&2
        exit 2 ;;
esac

data=$1
shift
case $data in /*) ;; *) data=$PWD/$data ;; esac
guest_value=0
for arg do
    if [ "$guest_value" = 1 ]; then
        guest_value=0
        continue
    fi
    case $arg in
        --guest-arg) guest_value=1 ;;
        --data-dir)
            printf '%s\n' 'Pass the data directory as the first AppImage argument.' >&2
            exit 2 ;;
    esac
done
exec "$appdir/everybodys-golf" --data-dir "$data" "$@"
